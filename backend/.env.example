# Copy to .env and fill in. The app runs WITHOUT any of these
# (offline mock LLM + SQLite + in-memory cache/rate-limit).

# --- LLM (optional; leave OPENAI_API_KEY empty to use the offline mock) -------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Auth (CHANGE THE SECRET IN PRODUCTION) -----------------------------------
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (optional; defaults to local SQLite) ----------------------------
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/copilot

# --- Redis (optional; enables cache, distributed rate limit, analytics counters,
#            and Celery broker. Empty => in-memory fallbacks) ------------------
# REDIS_URL=redis://localhost:6379/0

# --- Limits / CORS ------------------------------------------------------------
RATE_LIMIT_PER_DAY=100
CORS_ORIGINS=http://localhost:5173
